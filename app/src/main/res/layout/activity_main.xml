<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7FB">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#111827"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Captive Login"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- LEFT: WebView Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:radius="16dp"
            android:elevation="4dp"
            app:cardUseCompatPadding="true">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>



        <!-- RIGHT: Panel Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="12dp"
            android:radius="16dp"
            android:elevation="4dp"
            app:cardUseCompatPadding="true">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saved Credentials"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:paddingBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <!-- Login Button Container -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <Button
                                android:id="@+id/btnFillLogin"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:text="L"
                                android:textStyle="bold"
                                android:backgroundTint="#16A34A"
                                android:textColor="#FFFFFF"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Login"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <!-- Wi-Fi Button Container -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <Button
                                android:id="@+id/btnWifi"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:text="W"
                                android:textStyle="bold"
                                android:backgroundTint="#9CA3AF"
                                android:textColor="#FFFFFF"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />
                            <TextView
                                android:id="@+id/tvWifiLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wi-Fi"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <!-- Data Button Container -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <Button
                                android:id="@+id/btnData"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:text="D"
                                android:textStyle="bold"
                                android:backgroundTint="#9CA3AF"
                                android:textColor="#FFFFFF"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />
                            <TextView
                                android:id="@+id/tvDataLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Data"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <!-- Reload Button Container -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <Button
                                android:id="@+id/btnReload"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:text="R"
                                android:textStyle="bold"
                                android:backgroundTint="#374151"
                                android:textColor="#FFFFFF"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reload"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                    </LinearLayout>
                    <!-- Profile selector -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:paddingBottom="6dp" />

                    <Spinner
                        android:id="@+id/spProfile"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <Button
                            android:id="@+id/btnAddProfile"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="ADD"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="match_parent"/>

                        <Button
                            android:id="@+id/btnDeleteProfile"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="DELETE"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />


                    <!-- Username -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:paddingBottom="6dp" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="Enter login id"
                        android:inputType="textEmailAddress" />

                    <!-- Password -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:paddingTop="14dp"
                        android:paddingBottom="6dp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="password"
                        android:inputType="textPassword" />

                    <!-- Buttons -->
                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:text="SAVE"
                        android:textStyle="bold"
                        android:backgroundTint="#2563EB"
                        android:textColor="#FFFFFF" />



                    <!-- Portal URL moved to bottom -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Portal URL"
                        android:textStyle="bold"
                        android:paddingTop="18dp" />

                    <EditText
                        android:id="@+id/etPortalUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://10.0.112.2:8090/httpclient.html"
                        android:inputType="textUri" />

                    <Button
                        android:id="@+id/btnSaveUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Portal URL" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tip: Connect to WiFi first, then open this app."
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:paddingTop="16dp" />

                </LinearLayout>
            </ScrollView>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
